FINTECH_ENV=production
FINTECH_ADMIN_TOKEN=change-me-to-a-long-random-secret-please
FINTECH_SESSION_SECRET=change-me-another-long-random-secret
FINTECH_PUBLIC_BASE_URL=https://app.example.com
FINTECH_DATABASE_URL=postgresql+psycopg://fintech:fintech@postgres:5432/fintech
FINTECH_REDIS_URL=redis://redis:6379/0
FINTECH_CELERY_EAGER=false
FINTECH_STORAGE_BACKEND=s3
FINTECH_S3_BUCKET=fintech-uploads
FINTECH_S3_ENDPOINT_URL=http://minio:9000
AWS_ACCESS_KEY_ID=minio
AWS_SECRET_ACCESS_KEY=change-me-minio-secret
# Razorpay webhook secret (Dashboard > Webhooks). Leave empty to disable the endpoint.
FINTECH_RAZORPAY_WEBHOOK_SECRET=
# Optional inbound invoice mailbox
FINTECH_IMAP_HOST=
FINTECH_IMAP_USER=
FINTECH_IMAP_PASSWORD=
FINTECH_IMAP_TENANT_ID=
FINTECH_SENTRY_DSN=

# SSO via OpenID Connect (Keycloak, Authentik, Azure AD, Okta, Google...). Register redirect URI: <PUBLIC_BASE_URL>/auth/callback
FINTECH_OIDC_ISSUER=
FINTECH_OIDC_CLIENT_ID=
FINTECH_OIDC_CLIENT_SECRET=
FINTECH_OIDC_PROVIDER_NAME=SSO
# E-signature: PKCS#12 identity (issued to your organisation) used to seal completed PDFs
FINTECH_SIGNING_P12_PATH=/run/secrets/seal.p12
FINTECH_SIGNING_P12_PASSWORD=
# Outbound email for signing links / codes
FINTECH_SMTP_HOST=
FINTECH_SMTP_PORT=587
FINTECH_SMTP_USER=
FINTECH_SMTP_PASSWORD=
FINTECH_SMTP_FROM=no-reply@example.com
# Legal RAG: any OpenAI-compatible LLM. With the bundled Ollama profile: http://ollama:11434/v1 and a pulled model.
FINTECH_LLM_BASE_URL=
FINTECH_LLM_MODEL=
FINTECH_LLM_API_KEY=
# Optional dense retrieval (needs the image built with WITH_EMBEDDINGS=1), e.g. BAAI/bge-small-en-v1.5
FINTECH_EMBEDDING_MODEL=
